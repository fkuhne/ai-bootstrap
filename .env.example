# Copy this file to .env and change what you need. Every setting has a working
# default, so .env is optional. Docker Compose reads .env from this folder.

# --- The local LLM server (llama.cpp) ---

# 1 starts the local server (the default); 0 leaves it out, when the model is
# elsewhere (see the section below and docs/llms.md).
LLM_LOCAL_SERVER=1

# Where the model runs:
#   cpu     every machine (the default)
#   nvidia  an NVIDIA GPU: Linux with the NVIDIA Container Toolkit, or Windows with Docker Desktop
#   vulkan  an AMD or Intel GPU on Linux, or a Mac in a VM that exposes Vulkan (krunkit, libkrun)
# Neither GPU variant has been run on a GPU yet.
LLM_GPU=cpu

# The model: a Hugging Face GGUF repository and, when it holds several, the
# quantization after a colon. It's downloaded on the first start, with its image
# and audio component when it has one, and kept in a Docker volume.
# Suggested models, small to large (docs/models.md):
#   unsloth/Qwen3.5-2B-GGUF:Q4_K_M         2.0 GB  text, images, video
#   unsloth/Qwen3.5-4B-GGUF:Q4_K_M         3.4 GB  text, images, video (the default)
#   google/gemma-4-E4B-it-qat-q4_0-gguf    6.1 GB  text, images, audio
#   unsloth/Qwen3.5-9B-GGUF:Q4_K_M         6.6 GB  text, images, video
#   google/gemma-4-12B-it-qat-q4_0-gguf    7.2 GB  text, images, audio
LLM_HF_MODEL=unsloth/Qwen3.5-4B-GGUF:Q4_K_M

# The context window, in tokens. A bigger window takes more memory.
LLM_CONTEXT_SIZE=8192

# The port for the server's API and chat page, on this machine only.
LLM_PORT=8080

# --- How the LLM is reached ---

# openai-compatible (the default) reaches any OpenAI-compatible API; fake answers
# without a model, for tests.
LLM_PROVIDER=openai-compatible

# Any OpenAI-compatible API. The default is the local server above. Elsewhere, set
# LLM_LOCAL_SERVER=0 above, and the URL, key and model of the provider, for example
# (docs/llms.md lists more):
#   Ollama Cloud  https://ollama.com/v1                 gemma4:31b
#   OpenAI        https://api.openai.com/v1             gpt-6-luna
#   Anthropic     https://api.anthropic.com/v1/         claude-sonnet-5-5
#   llama.cpp on this machine, outside Docker: http://host.docker.internal:8080/v1
LLM_BASE_URL=http://llm:8080/v1

# The API key. The local server needs none.
LLM_API_KEY=

# The model's name at that API. The local server serves the one it loaded, whatever
# the name.
LLM_MODEL=local

# How long to wait for an answer, in seconds, and how many times to retry a request
# that failed before reaching the model. A timeout is never retried.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# What the model takes besides text, such as text,image or text,image,audio,video.
# The web UI offers attachments for those. Unset, the server's model list says, as
# llama.cpp's does; many cloud providers' lists don't, so set it for them.
LLM_INPUTS=

# --- The chat module ---

# Chat asks the LLM with the conversation the caller sends, whole or streamed
# (POST /api/chat). 0 turns it off: no endpoints. Written 0 or 1.
CHAT_ENABLED=1

# --- The conversations module ---

# Conversations keeps each user's conversations in PostgreSQL, and asks the LLM with
# their history (POST /api/conversations/{id}/messages). 0 turns it off: no endpoints,
# no migration job, and no database unless CONVERSATIONS_LOCAL_DATABASE says otherwise.
# Written 0 or 1.
CONVERSATIONS_ENABLED=1

# 1 starts the local PostgreSQL; 0 leaves it out, for a database elsewhere. Unset, it
# follows CONVERSATIONS_ENABLED.
# CONVERSATIONS_LOCAL_DATABASE=1

# The database's password. It's set when the database is first created, in its Docker
# volume; changing it later needs a new volume. Letters and digits only.
POSTGRES_PASSWORD=app-local

# The port for the database on this machine only, for tools such as psql.
POSTGRES_PORT=5433

# The database, as a SQLAlchemy URL. Unset, it's the local PostgreSQL: the service inside
# Compose, and the port above for code run outside Docker. For a database elsewhere, set
# CONVERSATIONS_LOCAL_DATABASE=0 and this; the migration job brings it up to date.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/app

# --- The decision module ---

# A decision model answers typed questions about a text with probabilities: yes or
# no, one of named options, or a level on a scale (POST /api/decide). 0 turns it off:
# no endpoint, no readiness check, and no local server unless DECISION_LOCAL_SERVER
# says otherwise. Written 0 or 1.
DECISION_ENABLED=1

# Which decision model answers:
#   systemone  any System One endpoint, at DECISION_BASE_URL (the default)
#   fake       answers without a model, for tests
DECISION_PROVIDER=systemone

# 1 starts the local decision server, llama.cpp with the model below; 0 leaves it out,
# when the model is elsewhere. Unset, it follows DECISION_ENABLED.
# DECISION_LOCAL_SERVER=1

# Where the local server runs: cpu, nvidia or vulkan. Unset, it follows LLM_GPU.
# DECISION_GPU=cpu

# The local decision model, from Hugging Face: ggml-org/Julia-1-GGUF:Q8_0 (0.17 GB, the
# fastest), ggml-org/Laya-GGUF:Q8_0 (0.45 GB, the default), or a larger one for a GPU,
# such as Kev-4B or Clef; docs/modules/decision.md lists them.
DECISION_HF_MODEL=ggml-org/Laya-GGUF:Q8_0

# The longest text it reads at once, in tokens; a longer one is refused. More takes
# more memory: 8192 took 1.7 GB on CPU with Laya.
DECISION_CONTEXT_SIZE=8192

# The port for the local server's API on this machine only.
DECISION_PORT=8081

# The System One endpoint's base; the backend adds /systemone. The default is the
# local server above. In the cloud, set DECISION_LOCAL_SERVER=0 and:
#   TypeSafe    https://api.typesafe.ai/v1      jev-latest
#   OpenRouter  https://openrouter.ai/api/v1    typesafe/jev-1.13
DECISION_BASE_URL=http://decision:8080/v1

# Its key, and the model's name there. The local server needs neither.
DECISION_API_KEY=
DECISION_MODEL=local

# How long to wait for the answers, in seconds.
DECISION_TIMEOUT_SECONDS=60

# --- The RAG module ---

# RAG finds the app's own chunks for the model to answer from. They're kept in Qdrant,
# with embeddings from an OpenAI-compatible API. 0 turns it off: no endpoints, no
# readiness check, and no local Qdrant or embedding server unless RAG_LOCAL_QDRANT or
# RAG_LOCAL_EMBEDDING says otherwise. Written 0 or 1.
RAG_ENABLED=1

# Where the chunks are kept and embedded:
#   qdrant  Qdrant at RAG_QDRANT_URL, embeddings from RAG_EMBEDDING_BASE_URL (the default)
#   fake    needs neither, for tests
RAG_PROVIDER=qdrant

# 1 starts Qdrant, which stores the chunks; 0 leaves it out, when Qdrant runs
# elsewhere. Unset, it follows RAG_ENABLED. Its dashboard: http://127.0.0.1:6333/dashboard
# RAG_LOCAL_QDRANT=1
RAG_QDRANT_PORT=6333

# 1 starts the local embedding server, llama.cpp with the model below; 0 leaves it out,
# when the embeddings come from elsewhere. Unset, it follows RAG_ENABLED.
# RAG_LOCAL_EMBEDDING=1

# Where the local embedding server runs: cpu, nvidia or vulkan. Unset, it follows LLM_GPU.
# RAG_GPU=cpu

# The local embedding model, from Hugging Face: ggml-org/embeddinggemma-2-GGUF:Q8_0
# (0.31 GB, the default), or another; docs/modules/rag.md lists them.
RAG_HF_MODEL=ggml-org/embeddinggemma-2-GGUF:Q8_0

# The longest text it embeds, in tokens; a longer one is refused. It also bounds the
# memory: about 1.5 GB on CPU at 1024, and about 1 MB more per token.
RAG_CONTEXT_SIZE=1024

# The port for the local embedding server's API on this machine only.
RAG_EMBEDDING_PORT=8082

# Qdrant's API, and its key. The default is the local service above; for Qdrant
# elsewhere, set RAG_LOCAL_QDRANT=0 and both.
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_API_KEY=

# The embeddings' API, its key, and the model's name there. The default is the local
# server above, which needs neither; elsewhere, set RAG_LOCAL_EMBEDDING=0 and all three,
# such as https://api.openai.com/v1 and text-embedding-3-small.
RAG_EMBEDDING_BASE_URL=http://embedding:8080/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=local

# How a question and a chunk are written before they're embedded, {text} standing for
# the text, and in a chunk's, {title} for its title, "none" without one. These are
# EmbeddingGemma 2's; a model that wants nothing around the text takes {text}.
# docs/modules/rag.md gives other models' formats.
RAG_QUERY_FORMAT="task: search result | query: {text}"
RAG_DOCUMENT_FORMAT="title: {title} | text: {text}"

# How long to wait for the embeddings and for Qdrant, in seconds.
RAG_TIMEOUT_SECONDS=60

# The Qdrant collection the chunks are kept in, made on the first store for the embedding
# model. After changing the model, delete it or name another, then store the chunks again.
RAG_COLLECTION=chunks

# BM25's language, for its stop words and stems, such as english or portuguese, and the
# chunks' average length in words. Unset, Qdrant's defaults apply: English, and 256.
RAG_BM25_LANGUAGE=
RAG_BM25_AVG_LEN=

# The similarity, from -1 to 1, below which a question's closest chunk is too far from it
# to answer from: the answer is "The documents don't say." and the model isn't asked.
# Unset, every question with a chunk found is answered. Set it from what /api/rag/search
# shows as similarities for your own questions; it depends on the embedding model.
RAG_MIN_SIMILARITY=

# --- The backend ---

# Generation parameters the chat and conversations demos add to each question, as a
# JSON object, such as {"temperature": 0.7} or
# {"reasoning_effort": "none"}. Empty: the provider's defaults.
CHAT_DEMO_PARAMETERS=

# The app's name: the API's title, and the web UI's title and sidebar. The web UI
# takes it when its image is built: docker compose up -d --build frontend
APP_NAME=ai-bootstrap

# How much the backend logs: DEBUG, INFO (the default), WARNING or ERROR. DEBUG adds
# each request the backend makes, and the health checks.
APP_LOG_LEVEL=INFO

# The API's documentation at /api/docs. Turn it off with false.
APP_DOCS_ENABLED=true

# The time zone of the backend's log times, such as America/Sao_Paulo or Europe/Berlin.
# UTC if unset; every time shows its offset either way.
# TZ=UTC

# The port for the backend's API on this machine only; its documentation is at
# http://127.0.0.1:8000/api/docs.
BACKEND_PORT=8000

# --- The web UI ---

# The port for the web UI on this machine only: http://127.0.0.1:3000
FRONTEND_PORT=3000
